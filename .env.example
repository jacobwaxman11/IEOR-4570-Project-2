GOOGLE_MAPS_API_KEY=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=

# local keeps the chat on SQLite. prod reads listings from BigQuery and writes
# chat history and saved listings there. Scripts mirror each SQLite write to
# BigQuery unless BQ_MIRROR=0. Dataset ids cannot contain hyphens.
APP_ENV=local
BQ_DATASET=IEOR_4570_Project_2
BQ_LOCATION=US
BQ_MIRROR=1
